#!/bin/bash -l
#PBS -N classic
#PBS -l select=1:ncpus=4:ngpus=1:mem=32GB:gpu_id=A100
#PBS -l walltime=24:00:00
#PBS -m abe
#PBS -M n11429984@qut.edu.au
#PBS -j oe
#PBS -q gpu_batch_exec

# Baseline-vs-selection experiment (clean head-to-head):
#   1. Train ONE baseline model (frame selection OFF, all N frames).
#   2. Eval that SAME checkpoint with selection OFF  -> baseline mAP.
#   3. Eval that SAME checkpoint with selection ON   -> selection mAP.
#   4. FLOP sweep (baseline vs TOP_K).
# Same config + same weights for both evals, so the only difference is selection.
# The "[LSTR] single-pass frame selection ACTIVE: keeping K/N" line prints only
# in eval step 3, proving selection is really pruning.

# ── Paths ────────────────────────────────────────────────────────────────────
REPO_DIR=~/long-short-term-transformer_forked
HPC_RUN_DIR=~/hpc_run

# Config has LONG_MEMORY_SECONDS=2048 -> N=2048 frames (matches earlier runs).
CONFIG=configs/THUMOS/LSTR/lstr_long_512_work_8_kinetics_1x_frameselect_singlepass.yaml
CKPT=checkpoints/THUMOS/LSTR/lstr_long_512_work_8_kinetics_1x_frameselect_singlepass/epoch-25.pth
TOP_K=128

# Eval-only memory-safety overrides: batch inference batch = BATCH_SIZE*16, which
# OOM-killed the DataLoader at BATCH_SIZE 16 / 8 workers on a 4-CPU/32GB node.
EVAL_OPTS="DATA_LOADER.BATCH_SIZE 4 DATA_LOADER.NUM_WORKERS 4 DATA_LOADER.PIN_MEMORY False"

# ── Environment ──────────────────────────────────────────────────────────────
cd "$REPO_DIR"
module load Miniconda3
conda activate lstr
export PYTHONPATH=$PYTHONPATH:$(pwd)/src

# ── 1) Train the BASELINE (selection forced OFF) ─────────────────────────────
python tools/train_net.py --config_file "$CONFIG" --gpu 0 \
    MODEL.LSTR.FRAME_SELECTION.ENABLED False
TRAIN_EXIT=$?

if [ $TRAIN_EXIT -eq 0 ]; then
    # ── 2) Eval the checkpoint with selection OFF -> baseline mAP ─────────────
    echo "########## EVAL A: BASELINE (frame selection OFF) ##########"
    python tools/test_net.py --config_file "$CONFIG" --gpu 0 \
        MODEL.CHECKPOINT "$CKPT" \
        MODEL.LSTR.FRAME_SELECTION.ENABLED False \
        $EVAL_OPTS

    # ── 3) Eval the SAME checkpoint with selection ON -> selection mAP ────────
    echo "########## EVAL B: FRAME SELECTION ON (TOP_K=$TOP_K) ##########"
    python tools/test_net.py --config_file "$CONFIG" --gpu 0 \
        MODEL.CHECKPOINT "$CKPT" \
        MODEL.LSTR.FRAME_SELECTION.ENABLED True \
        MODEL.LSTR.FRAME_SELECTION.TOP_K $TOP_K \
        MODEL.LSTR.FRAME_SELECTION.MODE drop \
        $EVAL_OPTS

    # ── 3b) Eval same checkpoint with the pre-embedding GATE (Upgrade B) ──────
    # Matched budget TOP_K so gate:norm / gate:uniform / attention are comparable.
    echo "########## EVAL C: FRAME GATE norm (TOP_K=$TOP_K) ##########"
    python tools/test_net.py --config_file "$CONFIG" --gpu 0 \
        MODEL.CHECKPOINT "$CKPT" \
        MODEL.LSTR.FRAME_GATE.ENABLED True \
        MODEL.LSTR.FRAME_GATE.SCORE norm \
        MODEL.LSTR.FRAME_GATE.TOP_K $TOP_K \
        $EVAL_OPTS

    echo "########## EVAL D: FRAME GATE uniform (TOP_K=$TOP_K) ##########"
    python tools/test_net.py --config_file "$CONFIG" --gpu 0 \
        MODEL.CHECKPOINT "$CKPT" \
        MODEL.LSTR.FRAME_GATE.ENABLED True \
        MODEL.LSTR.FRAME_GATE.SCORE uniform \
        MODEL.LSTR.FRAME_GATE.TOP_K $TOP_K \
        $EVAL_OPTS

    # ── 4) FLOPs (attention selection sweep) ─────────────────────────────────
    python tools/flop_frame_selection.py --config_file "$CONFIG" \
        --top_k 64 128 256

    # ── 5) Measured latency + params on the A100 (attention selection) ────────
    echo "########## BENCHMARK: measured latency / params / FLOPs ##########"
    python tools/benchmark_frame_selection.py --config_file "$CONFIG" \
        --top_k 64 128 256 --device cuda --iters 100

    # ── 6) 4-way method comparison at matched budget (FLOPs + latency) ────────
    echo "########## COMPARE: baseline / gate:uniform / gate:norm / attention ##########"
    python tools/compare_frame_methods.py --config_file "$CONFIG" \
        --top_k $TOP_K --device cuda --iters 100
else
    echo "Training failed (exit $TRAIN_EXIT); skipping eval and FLOPs."
fi

# ── Git commit (always) and push (best-effort) ───────────────────────────────
cd "$HPC_RUN_DIR"
git add logs/
git commit -m "logs: $(date +"%Y-%m-%d_%H-%M-%S") job=${PBS_JOBID} exit=${TRAIN_EXIT}"

if git push origin main; then
    echo "Logs pushed to GitHub."
else
    echo "WARNING: git push failed (compute node likely can't reach github.com)."
    echo "         Push it from the login node with:  cd ${HPC_RUN_DIR} && git push origin main"
    touch "${HPC_RUN_DIR}/.push_pending"
fi

# Exit with the TRAINING result, not the push result.
exit $TRAIN_EXIT
